# Copy this file to .env.local and fill in your Supabase credentials
# DO NOT commit .env.local to version control

# Supabase project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon public key (safe to expose — RLS enforces access controls)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: App title override
VITE_APP_TITLE=UniConnect
